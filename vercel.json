{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix services/coordinator ci --include=dev",
  "buildCommand": "npm --prefix services/coordinator run build:vercel",
  "outputDirectory": "services/coordinator/.vercel-static",
  "regions": ["iad1"],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "services/coordinator/{public,notices}/**"
    }
  },
  "rewrites": [
    {"source": "/(.*)", "destination": "/api/index"}
  ]
}
