{
  "name": "cybernote",
  "version": "0.2.9",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/versions.mjs --build pnpm build:frontend",
    "build:frontend": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "tauri": "tauri",
    "mac:dev": "tauri dev",
    "mac:build": "node scripts/versions.mjs --build pnpm exec tauri build --bundles app",
    "android:init": "node scripts/android.mjs init",
    "android:build": "node scripts/versions.mjs --build node scripts/android.mjs build",
    "android:dev": "node scripts/android.mjs dev",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:schema": "node scripts/check-editor-schema.mjs",
    "test:editor": "node scripts/check-editor-actions.mjs",
    "test:editor-hot-path": "node scripts/check-editor-hot-path.mjs",
    "test:save-scheduler": "node scripts/check-editor-save-scheduler.mjs",
    "test:workspace-projection": "node scripts/check-workspace-projection.mjs",
    "test:access": "node scripts/check-access-boundary.mjs",
    "test:secure-id": "node scripts/check-secure-id.mjs",
    "test:desktop-appearance": "node scripts/check-desktop-appearance.mjs",
    "test:native-toolbar": "node scripts/check-native-toolbar.mjs",
    "debug": "node scripts/debug/cli.mjs",
    "test:debug": "node scripts/debug/cli.mjs all",
    "test:native-appearance": "node scripts/check-native-appearance.mjs",
    "test:table-controls": "node scripts/check-table-controls-browser.mjs",
    "test:button-feedback": "node scripts/check-button-feedback-browser.mjs",
    "test:startup": "node scripts/check-startup.mjs",
    "test:attachment-gallery": "node scripts/check-attachment-gallery.mjs",
    "test:recording-refresh": "node scripts/check-recording-refresh.mjs",
    "test:evolve113-interaction": "node scripts/check-evolve113-interaction.mjs",
    "test:mobile-editor": "node scripts/check-mobile-editor-interactions.mjs",
    "test:note-move-menu": "node scripts/check-note-move-menu.mjs",
    "test:attachment-files": "node scripts/check-attachment-files-browser.mjs",
    "test:attachment-mime": "node scripts/check-attachment-mime.mjs",
    "test:attachment-clipboard-native": "node scripts/check-attachment-files-native.mjs",
    "test:menu-lifetimes": "node scripts/check-menu-lifetimes.mjs",
    "test:native-menus": "node scripts/check-unified-menus-native.mjs",
    "test:native-menu-client": "node scripts/check-native-menu-browser.mjs",
    "test:drawing": "node scripts/check-drawing-interactions.mjs",
    "version:check": "node scripts/versions.mjs --check",
    "version:next": "node scripts/versions.mjs --next",
    "version:sync": "node scripts/versions.mjs",
    "release": "node scripts/release.mjs",
    "test:build-info": "node scripts/check-build-info.mjs",
    "plugin:package": "python3 scripts/package-plugin.py --source examples/plugins/cybernote.sample --output release-packages/cybernote-sample-plugin.zip"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-highlight": "^3.10.0",
    "@tiptap/extension-image": "^3.10.0",
    "@tiptap/extension-placeholder": "^3.10.0",
    "@tiptap/extension-table": "^3.10.0",
    "@tiptap/extension-task-item": "^3.10.0",
    "@tiptap/extension-task-list": "^3.10.0",
    "@tiptap/extension-text-style": "^3.10.0",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "^3.10.0",
    "@tiptap/starter-kit": "^3.10.0",
    "core-js": "^3.51.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "prettier": "^3.9.10",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  }
}
