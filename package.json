{
  "name": "notes-clone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "tauri": "tauri",
    "mac:dev": "tauri dev",
    "mac:build": "tauri build --bundles app",
    "android:init": "node scripts/android.mjs init",
    "android:build": "node scripts/android.mjs build",
    "android:dev": "node scripts/android.mjs dev",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:schema": "node scripts/check-editor-schema.mjs",
    "test:editor": "node scripts/check-editor-actions.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-highlight": "^3.10.0",
    "@tiptap/extension-image": "^3.10.0",
    "@tiptap/extension-placeholder": "^3.10.0",
    "@tiptap/extension-table": "^3.10.0",
    "@tiptap/extension-task-item": "^3.10.0",
    "@tiptap/extension-task-list": "^3.10.0",
    "@tiptap/extension-text-style": "^3.10.0",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "^3.10.0",
    "@tiptap/starter-kit": "^3.10.0",
    "core-js": "^3.51.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "prettier": "^3.9.10",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  }
}
