{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CyberNote",
  "version": "0.2.7",
  "identifier": "com.local.notesclone",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CyberNote",
        "width": 1560,
        "height": 960,
        "minWidth": 1000,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 25
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' http://127.0.0.1:* asset: http://asset.localhost data: blob:; media-src 'self' http://127.0.0.1:* asset: http://asset.localhost data: blob:; connect-src http://127.0.0.1:* ipc: http://ipc.localhost 'self' blob:; font-src 'self' data:; frame-src 'none'; child-src 'none'; object-src 'none'; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/attachments/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Productivity",
    "shortDescription": "CyberNote · 让记录更自然",
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "android": {
      "minSdkVersion": 26
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "com.local.notesclone.auth"
          ],
          "host": "callback",
          "appLink": false
        }
      ]
    }
  }
}
