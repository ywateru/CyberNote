{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "recording-owner-window",
  "description": "Keep the original recording owner alive when closed and reveal that same window",
  "windows": ["main", "note-*"],
  "permissions": ["core:window:allow-hide", "core:window:allow-show", "core:window:allow-set-focus"]
}
