@@ -0,0 +1,18 @@
+import assert from 'node:assert/strict';
+import {openOwnedProvider} from './provider-touch.mjs';
+const point={x:20,y:30,width:360,height:568};
+function fake({menu=false,value=point,failAt=0}={}) {
+  const calls=[];let n=0;
+  return {calls,read:async expression=>{calls.push(['read',expression]);return expression.startsWith('!!')?menu:value;},wait:async(...args)=>{calls.push(['wait',...args]);},send:async(...args)=>{calls.push(['send',...args]);if(++n===failAt)throw Error('SECRET_IPC_ERROR');}};
+}
+for(const menu of [false,true]){
+  const c=fake({menu});assert.deepEqual(await openOwnedProvider(c),{normalTouch:true});
+  const sent=c.calls.filter(c=>c[0]==='send');assert.equal(sent.length,menu?2:4);
+  assert(sent.every(c=>c[1]==='Input.dispatchTouchEvent'));
+  for(let i=0;i<sent.length;i+=2){assert.deepEqual(sent[i][2],{type:'touchStart',touchPoints:[{x:20,y:30}]});assert.deepEqual(sent[i+1][2],{type:'touchEnd',touchPoints:[]});}
+}
+for(const value of [{...point,x:360},{...point,width:721},{...point,y:NaN},{...point,SECRET_KEY:1},Object.defineProperty({...point},'x',{get(){throw Error('SECRET_GETTER');}})]){
+  const c=fake({value});await assert.rejects(openOwnedProvider(c),e=>e.message==='owned provider touch refused'&&!e.cause&&!Object.hasOwn(e,'actual'));assert.equal(c.calls.filter(c=>c[0]==='send').length,0);
+}
+const failed=fake({failAt:1});await assert.rejects(openOwnedProvider(failed),{message:'owned provider touch refused'});assert.equal(failed.calls.filter(c=>c[0]==='send').length,1);
+console.log(JSON.stringify({ok:true,checks:8}));
diff --git a/scripts/debug/sync87-native/provider-touch.mjs b/scripts/debug/sync87-native/provider-touch.mjs
new file mode 100644
index 00000000..d9880764
--- /dev/null
+++ b/scripts/debug/sync87-native/provider-touch.mjs
@@ -0,0 +1,38 @@
+/** Normal CDP touch for two fixed visible provider controls on the owned final02 note. */
+import assert from 'node:assert/strict';
+
+async function touch(client, control) {
+  assert(['attachment','file'].includes(control));
+  const point = await client.read(`(()=>{
+    if(!document.querySelector('.mobile.page-editor')||document.querySelector('.tiptap h1')?.textContent!=='SYNC87-74da049123-1')throw Error('owned editor required');
+    const control=${JSON.stringify(control)};
+    const found=[...document.querySelectorAll(control==='attachment'?'button[aria-label="添加附件"]':'.menu-media[role="menu"] button')].filter(e=>{
+      const r=e.getBoundingClientRect(),s=getComputedStyle(e);
+      return !e.disabled&&s.visibility==='visible'&&s.display!=='none'&&r.width>0&&r.height>0&&(control==='attachment'||e.textContent.trim()==='附加文件');
+    });
+    if(found.length!==1)throw Error('one visible fixed control required');
+    const e=found[0],r=e.getBoundingClientRect(),x=r.x+r.width/2,y=r.y+r.height/2;
+    const hit=document.elementFromPoint(x,y);
+    if(!(x>=0&&y>=0&&x<innerWidth&&y<innerHeight&&hit&&(hit===e||e.contains(hit))))throw Error('unobscured viewport control required');
+    return {x,y,width:innerWidth,height:innerHeight};
+  })()`);
+  assert(point&&typeof point==='object'&&!Array.isArray(point));
+  const descriptors=Object.getOwnPropertyDescriptors(point);
+  assert.deepEqual(Object.keys(descriptors).sort(),['height','width','x','y']);
+  assert(Object.values(descriptors).every(d=>Object.hasOwn(d,'value')&&typeof d.value==='number'&&Number.isFinite(d.value)));
+  const {x,y,width,height}=Object.fromEntries(Object.entries(descriptors).map(([k,d])=>[k,d.value]));
+  assert(width>0&&width<=720&&height>0&&height<=1280&&x>=0&&y>=0&&x<width&&y<height);
+  await client.send('Input.dispatchTouchEvent',{type:'touchStart',touchPoints:[{x,y}]});
+  await client.send('Input.dispatchTouchEvent',{type:'touchEnd',touchPoints:[]});
+}
+
+export async function openOwnedProvider(client) {
+  try {
+    const menu=await client.read('!!document.querySelector(".menu-media[role=menu]")');
+    assert(typeof menu==='boolean');
+    if(!menu)await touch(client,'attachment');
+    await client.wait('!!document.querySelector(".menu-media[role=menu]")','fixed attachment menu');
+    await touch(client,'file');
+    return {normalTouch:true};
+  } catch { throw Error('owned provider touch refused'); }
+}
