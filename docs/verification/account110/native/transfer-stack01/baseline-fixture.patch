+                    let binding = Binding {
+                        issuer: config::ISSUER.into(), subject: "fixture-owner".into(), product_id: "fixture".into(),
+                        workspace_id: uuid::Uuid::new_v4().to_string(), device_id: identity.device_id().unwrap(),
+                        noise_public_key: identity.public_key().unwrap(), enabled: true,
+                    };
+                    let backend = Arc::new(BlockingBackend {
+                        device: binding.device_id.clone(), workspace: binding.workspace_id.clone(), block: false,
+                        entered: Default::default(), release: Arc::new((Mutex::new(true), Condvar::new())),
+                        inventories: AtomicUsize::new(0),
+                    });
+                    let gate = Arc::new(Gate::default());
+                    let service = Arc::new(SyncService::with_policy(backend.clone(), identity.clone(), root.path().join("stage"), Some(gate.clone())).unwrap());
+                    let client = Client::new(cybergrid_sdk::Config {
+                        base_url: config::origin().unwrap(), app_id: config::CLIENT_ID.into(), ..Default::default()
+                    }).unwrap();
+                    let enrollment = Arc::new(Enrollment::new(config::origin().unwrap()).unwrap());
+                    let bootstrap = Bootstrap { enrollment: enrollment.clone(), binding: binding.clone(), identity: identity.clone(), gate: gate.clone(), proof: Mutex::new(String::new()) };
+                    let target = super::super::directory::Row {
+                        id: uuid::Uuid::new_v4().to_string(), name: "Fixture".into(), online: true, sync_available: true,
+                        summary: None, transport_device_id: Some("fixture-transport".into()),
+                        protocol_device_id: Some(uuid::Uuid::new_v4().to_string()), noise_public_key: Some(B64.encode([9; 32])),
+                    };
+                    let stop = CancellationToken::new();
