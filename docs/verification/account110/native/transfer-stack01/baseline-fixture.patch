+                    let make = || transfer_target(&service, &identity, &binding, &client, &enrollment, &gate,
+                        &bootstrap, &target, super::super::types::TransferDirection::Push, None, &stop, &cancellation);
+                    let transfer = make();
+                    eprintln!("real transfer_target future bytes={}", std::mem::size_of_val(&transfer));
+                    let mut cx = Context::from_waker(Waker::noop());
+                    if mode == "cancel" {
+                        stop.cancel();
+                        let mut transfer = Box::pin(transfer);
