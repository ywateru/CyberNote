      "634:   pub(crate) fn attach_webview(",
      "635:     &self,",
      "636:     window: Window<R>,",
      "637:     webview: DetachedWebview<EventLoopMessage, R>,",
      "638:     use_https_scheme: bool,",
      "639:   ) -> Webview<R> {",
      "640:     let webview = Webview::new(window, webview, use_https_scheme);",
      "641: ",
      "642:     let webview_event_listeners = self.event_listeners.clone();",
      "643:     let webview_ = webview.clone();",
      "644:     webview.on_webview_event(move |event| {",
      "645:       let _ = on_webview_event(&webview_, event);",
      "646:       for handler in webview_event_listeners.iter() {",
      "647:         handler(&webview_, event);",
      "648:       }",
      "649:     });",
      "650: ",
      "651:     // insert the webview into our manager",
      "652:     {",
      "653:       self",
      "654:         .webviews_lock()",
      "655:         .insert(webview.label().to_string(), webview.clone());",
      "656:     }",
      "657: ",
      "658:     // let plugins know that a new webview has been added to the manager",
      "659:     let manager = webview.manager_owned();",
      "660:     let webview_ = webview.clone();",
      "661:     // run on main thread so the plugin store doesn't dead lock with the event loop handler in App",
      "662:     let _ = webview.run_on_main_thread(move || {",
      "663:       manager",
      "664:         .plugins",
      "665:         .lock()",
      "666:         .expect(\"poisoned plugin store\")",
      "667:         .webview_created(webview_);",
      "668:     });"
    ]
  },
