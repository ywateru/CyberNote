      "531:   pub fn on_webview_ready<F>(mut self, on_webview_ready: F) -> Self",
      "532:   where",
      "533:     F: FnMut(Webview<R>) + Send + 'static,",
      "534:   {",
      "535:     self.on_webview_ready = Box::new(on_webview_ready);",
