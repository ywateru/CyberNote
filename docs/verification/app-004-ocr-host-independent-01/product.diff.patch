+          },
+        ),
+      };
+    });
+    assert.ok(
+      geometry.panel.x >= 0 &&
+        geometry.panel.y >= 0 &&
+        geometry.panel.right <= 320 &&
+        geometry.panel.bottom <= 568,
+    );
+    assert.ok(geometry.textScrollable);
+    assert.ok(
+      geometry.buttons.every(
+        (r) => r.height >= 44 && r.width >= 44 && r.bottom <= 568,
