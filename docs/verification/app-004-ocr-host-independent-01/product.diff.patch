+.ocr-sources {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 12px;
+}
+.ocr-panel button {
+  min-height: 44px;
+  padding: 8px 16px;
+  border: 0;
+  border-radius: 10px;
+  background: var(--grouped);
