# Isolated standalone development template, NOT production configuration.
# Replace example origins and client IDs with dedicated Logto/environment values.
# The fixed native client must be rebuilt if these identity inputs differ.
LOGTO_ISSUER=https://auth.example.com/oidc
LOGTO_RESOURCE=https://notes.example.com/api
LOGTO_BROWSER_CLIENT_ID=notes-console-dev
CYBERGRID_PRODUCTS='{"version":1,"products":[{"id":"notes-native-dev","name":"CyberNote development","nativeClientIds":["notes-native-dev"],"browserClientIds":["notes-console-dev"]}]}'

# Stable canonical HTTPS origin AND enrollment issuer for this NEW environment.
# Existing production must retain its original issuer; see docs/server/README.md.
CYBERGRID_PUBLIC_ORIGIN=https://coordinator.example.com
CYBERGRID_REDIS_TRANSPORT=tcp
REDIS_URL=redis://127.0.0.1:6379
CYBERGRID_REDIS_PREFIX=cybernote:dev:v1

# Required stable secrets: replace BOTH values; never regenerate for redeploys.
# See docs/server/DEPLOYMENT.md for first-time local generation to .env.secrets.
CYBERNOTE_WORKSPACE_SEED=REPLACE_WITH_CANONICAL_BASE64URL_OF_32_TO_96_RANDOM_BYTES
CYBERNOTE_ENROLLMENT_JWK='REPLACE_WITH_PRIVATE_EC_P384_JWK_JSON'

CYBERGRID_BIND=127.0.0.1
PORT=7400
